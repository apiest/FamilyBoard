{
  "config": {
    "step": {
      "user": {
        "title": "FamilyBoard",
        "description": "FamilyBoard will be created as a singleton entry. After it is created, open it under Settings → Devices & Services → FamilyBoard → Configure to add members, trash collections and shared items."
      }
    },
    "abort": {
      "single_instance_allowed": "Only one FamilyBoard instance is supported."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "FamilyBoard",
        "description": "All FamilyBoard configuration is now organised as sub-items on this integration page. Click ➕ above to add a member, shared calendar, shared chore, trash collection, or the meal planner. There are no global options to set here."
      }
    }
  },
  "config_subentries": {
    "member": {
      "initiate_flow": {
        "user": "Add member",
        "reconfigure": "Reconfigure member"
      },
      "entry_type": "Member",
      "step": {
        "user": {
          "title": "Member",
          "data": {
            "name": "Name",
            "calendar": "Primary calendar",
            "calendar_label": "Calendar label",
            "color": "Color (hex)",
            "person": "Person entity",
            "notify": "Notify target (mobile_app_*)",
            "chores": "Chore lists",
            "category": "Calendar category"
          }
        }
      }
    },
    "extra_calendar": {
      "initiate_flow": {
        "user": "Add extra calendar",
        "reconfigure": "Reconfigure extra calendar"
      },
      "entry_type": "Extra calendar",
      "abort": {
        "no_members": "Add a member first before adding extra calendars."
      },
      "step": {
        "user": {
          "title": "Extra calendar",
          "data": {
            "parent_member": "Member",
            "entity": "Calendar entity",
            "label": "Label",
            "default_summary": "Default summary",
            "default_description": "Default description",
            "category": "Calendar category"
          }
        }
      }
    },
    "shared_calendar": {
      "initiate_flow": {
        "user": "Add shared calendar",
        "reconfigure": "Reconfigure shared calendar"
      },
      "entry_type": "Shared calendar",
      "step": {
        "user": {
          "title": "Shared calendar",
          "data": {
            "entity": "Calendar entity",
            "members": "Members",
            "name": "Name",
            "color": "Color (hex)",
            "category": "Calendar category"
          }
        }
      }
    },
    "shared_chore": {
      "initiate_flow": {
        "user": "Add shared chore",
        "reconfigure": "Reconfigure shared chore"
      },
      "entry_type": "Shared chore",
      "step": {
        "user": {
          "title": "Shared chore",
          "data": {
            "entity": "Todo entity",
            "members": "Members",
            "type": "Type (set to 'trash' for auto-creation from trash sensors)",
            "name": "Name",
            "color": "Color (hex)"
          }
        }
      }
    },
    "trash": {
      "initiate_flow": {
        "user": "Add trash collection",
        "reconfigure": "Reconfigure trash collection"
      },
      "entry_type": "Trash collection",
      "step": {
        "user": {
          "title": "Trash collection",
          "data": {
            "type": "Type",
            "sensor": "Sensor",
            "label": "Label",
            "color": "Color (hex)",
            "emoji": "Emoji",
            "reminder_bins": "Auto-create chore: empty bins (evening before)",
            "reminder_kliko": "Auto-create chore: kliko at the curb (morning of)"
          }
        }
      }
    },
    "meal_planner": {
      "initiate_flow": {
        "user": "Add meal planner",
        "reconfigure": "Reconfigure meal planner"
      },
      "entry_type": "Meal planner",
      "step": {
        "user": {
          "title": "Meal planner",
          "description": "Calendar for meal events + AI suggestion settings. Empty fields use sensible defaults; one item per line for the lists.",
          "data": {
            "meal_calendar": "Meal calendar",
            "ai_task_entity": "AI task entity",
            "shopping_list": "Shopping list (todo)",
            "max_minutes": "Maximum prep time (min)",
            "cuisines": "Cuisines (one per line)",
            "pantry_staples": "Pantry staples (one per line)",
            "restrictions": "Restrictions (one per line)",
            "extra_notes": "Extra instructions (free text)"
          }
        }
      },
      "abort": {
        "already_configured": "A meal planner already exists. Reconfigure that one instead of adding a new one."
      }
    },
    "meal_day_override": {
      "initiate_flow": {
        "user": "Add meal weekday override",
        "reconfigure": "Reconfigure meal weekday override"
      },
      "entry_type": "Meal weekday override",
      "abort": {
        "no_weekdays_left": "All seven weekdays already have an override."
      },
      "step": {
        "user": {
          "title": "Weekday override",
          "description": "Tweak the AI meal suggestion for one specific weekday. The note is appended to the prompt (e.g. 'Training at 6pm — keep it quick'); max prep time overrides the planner default for that day. Leave both empty to skip.",
          "data": {
            "weekday": "Weekday",
            "note": "Note for the AI prompt",
            "max_minutes": "Max prep time (minutes, overrides planner default)"
          }
        }
      }
    },
    "display": {
      "initiate_flow": {
        "user": "Add display settings",
        "reconfigure": "Reconfigure display settings"
      },
      "entry_type": "Display",
      "step": {
        "user": {
          "title": "Display settings",
          "description": "Toggle urgency tiers and customise their accent colors.",
          "data": {
            "due_today_enabled": "Show 'due today' styling",
            "due_today_color": "Due today color",
            "due_soon_enabled": "Show 'due soon' styling",
            "due_soon_color": "Due soon color",
            "overdue_enabled": "Show 'overdue' styling",
            "overdue_color": "Overdue color"
          }
        }
      },
      "abort": {
        "already_configured": "Display settings already exist. Reconfigure the existing entry instead."
      }
    },
    "caldav_connection": {
      "initiate_flow": {
        "user": "Add CalDAV connection",
        "reconfigure": "Reconfigure CalDAV connection"
      },
      "entry_type": "CalDAV connection",
      "step": {
        "user": {
          "title": "CalDAV connection",
          "description": "Connect to a CalDAV server (e.g. Nextcloud) for RFC-compliant todo management with recurring task support.",
          "data": {
            "url": "CalDAV server URL",
            "username": "Username",
            "password": "Password",
            "name": "Connection name (optional)",
            "verify_ssl": "Verify SSL certificate",
            "server_handles_rrule": "Server handles recurring tasks"
          }
        }
      }
    }
  },
