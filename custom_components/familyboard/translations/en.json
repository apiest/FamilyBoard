{
  "config": {
    "step": {
      "user": {
        "title": "FamilyBoard",
        "description": "FamilyBoard will be created as a singleton entry. After it is created, open it under Settings \u2192 Devices & Services \u2192 FamilyBoard \u2192 Configure to add members, trash collections and shared items."
      }
    },
    "abort": {
      "single_instance_allowed": "Only one FamilyBoard instance is supported."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "FamilyBoard",
        "description": "All FamilyBoard configuration is now organised as sub-items on this integration page. Click ➕ above to add a member, shared calendar, shared chore, trash collection, or the meal planner. There are no global options to set here."
      }
    }
  },
  "config_subentries": {
    "member": {
      "initiate_flow": {
        "user": "Add member",
        "reconfigure": "Reconfigure member"
      },
      "entry_type": "Member",
      "step": {
        "user": {
          "title": "Member",
          "data": {
            "name": "Name",
            "calendar": "Primary calendar",
            "calendar_label": "Calendar label",
            "color": "Color (hex)",
            "person": "Person entity",
            "notify": "Notify target (mobile_app_*)",
            "chores": "Chore lists"
          }
        }
      }
    },
    "extra_calendar": {
      "initiate_flow": {
        "user": "Add extra calendar",
        "reconfigure": "Reconfigure extra calendar"
      },
      "entry_type": "Extra calendar",
      "abort": {
        "no_members": "Add a member first before adding extra calendars."
      },
      "step": {
        "user": {
          "title": "Extra calendar",
          "data": {
            "parent_member": "Member",
            "entity": "Calendar entity",
            "label": "Label",
            "default_summary": "Default summary",
            "default_description": "Default description"
          }
        }
      }
    },
    "shared_calendar": {
      "initiate_flow": {
        "user": "Add shared calendar",
        "reconfigure": "Reconfigure shared calendar"
      },
      "entry_type": "Shared calendar",
      "step": {
        "user": {
          "title": "Shared calendar",
          "data": {
            "entity": "Calendar entity",
            "members": "Members",
            "name": "Name",
            "color": "Color (hex)"
          }
        }
      }
    },
    "shared_chore": {
      "initiate_flow": {
        "user": "Add shared chore",
        "reconfigure": "Reconfigure shared chore"
      },
      "entry_type": "Shared chore",
      "step": {
        "user": {
          "title": "Shared chore",
          "data": {
            "entity": "Todo entity",
            "members": "Members",
            "type": "Type (set to 'trash' for auto-creation from trash sensors)",
            "name": "Name",
            "color": "Color (hex)"
          }
        }
      }
    },
    "trash": {
      "initiate_flow": {
        "user": "Add trash collection",
        "reconfigure": "Reconfigure trash collection"
      },
      "entry_type": "Trash collection",
      "step": {
        "user": {
          "title": "Trash collection",
          "data": {
            "type": "Type",
            "sensor": "Sensor",
            "label": "Label",
            "color": "Color (hex)",
            "emoji": "Emoji",
            "reminder_bins": "Auto-create chore: empty bins (evening before)",
            "reminder_kliko": "Auto-create chore: kliko at the curb (morning of)"
          }
        }
      }
    },
    "meal_planner": {
      "initiate_flow": {
        "user": "Add meal planner",
        "reconfigure": "Reconfigure meal planner"
      },
      "entry_type": "Meal planner",
      "step": {
        "user": {
          "title": "Meal planner",
          "description": "Calendar for meal events + AI suggestion settings. Empty fields use sensible defaults; one item per line for the lists.",
          "data": {
            "meal_calendar": "Meal calendar",
            "ai_task_entity": "AI task entity",
            "shopping_list": "Shopping list (todo)",
            "max_minutes": "Maximum prep time (min)",
            "cuisines": "Cuisines (one per line)",
            "pantry_staples": "Pantry staples (one per line)",
            "restrictions": "Restrictions (one per line)",
            "extra_notes": "Extra instructions (free text)"
          }
        }
      }
    },
    "meal_day_override": {
      "initiate_flow": {
        "user": "Add weekday override",
        "reconfigure": "Reconfigure weekday override"
      },
      "entry_type": "Meal day override",
      "abort": {
        "no_weekdays_left": "All seven weekdays already have an override."
      },
      "step": {
        "user": {
          "title": "Weekday override",
          "data": {
            "weekday": "Weekday",
            "note": "Note (free text)",
            "max_minutes": "Maximum prep time (min)"
          }
        }
      }
    }
  },
  "entity": {
    "calendar": {
      "alles": { "name": "All" },
      "trash": { "name": "Trash" }
    },
    "sensor": {
      "chores": { "name": "Chores" },
      "compliment": { "name": "Greeting" },
      "meals": { "name": "Meals" },
      "recent_meals": { "name": "Recent meals" },
      "meal_suggestion": { "name": "Meal suggestion" },
      "members": { "name": "Members" },
      "progress": { "name": "Progress" }
    },
    "binary_sensor": {
      "meals_unplanned": { "name": "Meals to plan" }
    },
    "select": {
      "calendar_filter": { "name": "Calendar filter" },
      "view": {
        "name": "View",
        "state": {
          "today": "Today",
          "2_days": "2 Days",
          "3_days": "3 Days",
          "week": "Week",
          "work_week": "Work week",
          "two_weeks": "2 Weeks",
          "month": "Month"
        }
      },
      "layout": {
        "name": "Layout",
        "state": {
          "list": "List",
          "agenda": "Agenda"
        }
      },
      "event_member": { "name": "Event member" },
      "event_calendar": { "name": "Event calendar" }
    },
    "switch": {
      "event_all_day": { "name": "Event all day" },
      "show_reminders": { "name": "Show reminders" },
      "category_personal": { "name": "Personal" },
      "category_work": { "name": "Work" },
      "category_school": { "name": "School" },
      "category_hobby": { "name": "Hobby" },
      "category_family": { "name": "Family" },
      "category_other": { "name": "Other" }
    },
    "text": {
      "event_title": { "name": "Event title" },
      "countdown_label": { "name": "Countdown label" }
    },
    "datetime": {
      "event_start": { "name": "Event start" },
      "event_end": { "name": "Event end" },
      "day_start": { "name": "Day start" },
      "day_end": { "name": "Day end" },
      "countdown_date": { "name": "Countdown date" }
    }
  },
  "services": {
    "add_event": {
      "name": "Add calendar event",
      "description": "Create a calendar event using the FamilyBoard add-event form entities and reset the form."
    },
    "snooze_test": {
      "name": "Test snooze reminder",
      "description": "Force-fire a snooze notification for a given task uid (for testing).",
      "fields": {
        "uid": {
          "name": "Task UID",
          "description": "The Google Tasks uid of the task to fire a reminder for."
        }
      }
    },
    "cancel_reminder": {
      "name": "Cancel snooze reminder",
      "description": "Cancel an active snooze reminder for a given task uid.",
      "fields": {
        "uid": {
          "name": "Task UID",
          "description": "The Google Tasks uid of the reminder to cancel."
        }
      }
    },
    "suggest_meal": {
      "name": "Suggest meal",
      "description": "Generate a meal suggestion via ai_task.generate_data and store it on sensor.familyboard_meal_suggestion.",
      "fields": {
        "date": {
          "name": "Target date",
          "description": "The date the meal is for. Defaults to today."
        },
        "ai_task_entity": {
          "name": "AI task entity",
          "description": "One-shot override of the configured ai_task_entity."
        }
      }
    },
    "accept_meal_suggestion": {
      "name": "Accept suggestion",
      "description": "Plan the current suggestion as a meal_calendar event and append ingredients to the shopping list."
    },
    "clear_meal_suggestion": {
      "name": "Clear suggestion",
      "description": "Discard the current meal suggestion without acting on it."
    }
  }
}
